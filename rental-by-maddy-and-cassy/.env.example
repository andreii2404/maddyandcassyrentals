# Supabase project configuration (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=

# PayMongo. Secret and webhook keys are server-only — never prefix them
# with NEXT_PUBLIC_. Use TEST keys for local/dev; LIVE keys belong only in
# the Vercel Production environment. Leave secret/webhook blank in
# development to use the sandbox /demo/paymongo flow instead of live checkout.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=whsk_
PAYMONGO_PAYMENT_METHODS=gcash,card,qrph

NEXT_PUBLIC_APP_URL=https://rentals.example.com

# Transactional booking emails (approval and completed return). Create an API
# key and verify the sender/domain in Resend. These values are server-only.
RESEND_API_KEY=re_
BOOKING_EMAIL_FROM=Rental by Maddy & Cassy <bookings@yourdomain.com>
BOOKING_EMAIL_REPLY_TO=

# Web Push (VAPID) — replaces Firebase Cloud Messaging. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:your-business@example.com
