# Supabase project configuration (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=https://rentals.example.com

# Transactional booking emails (approval, completed return, and the official
# receipt PDF). Create an API key at https://resend.com/api-keys. These values
# are server-only. Without both RESEND_API_KEY and BOOKING_EMAIL_FROM the
# "Send Receipt to Email" action returns a "not configured" error.
#
# BOOKING_EMAIL_FROM must use a domain you have verified at
# https://resend.com/domains. For local development you can instead use the
# shared Resend test sender below, which needs no domain verification but can
# only deliver to the email address that owns the Resend account:
#   BOOKING_EMAIL_FROM=Rental by Maddy & Cassy <onboarding@resend.dev>
RESEND_API_KEY=re_
BOOKING_EMAIL_FROM=Rental by Maddy & Cassy <bookings@yourdomain.com>
BOOKING_EMAIL_REPLY_TO=

# Web Push (VAPID) — replaces Firebase Cloud Messaging. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:your-business@example.com
