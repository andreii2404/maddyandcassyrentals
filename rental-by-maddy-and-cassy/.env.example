# Supabase project configuration (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only, never exposed to the browser.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_APP_URL=https://rentals.example.com

# Transactional booking emails are sent by this Supabase Edge Function, which
# owns the Gmail SMTP configuration. The function receives { to, subject, html,
# text }. These values are server-only; the service key is never exposed to the browser.
SUPABASE_EMAIL_FUNCTION_NAME=send-booking-emails

# Web Push (VAPID) — replaces Firebase Cloud Messaging. Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:your-business@example.com
